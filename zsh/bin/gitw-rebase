#!/usr/bin/env python3

import subprocess
import sys

import _utils

if not _utils.inside_worktree():
    _utils.error("Must be run inside a git worktree")
    sys.exit(1)

cur_branch = _utils.get_current_branch()
base_branch = (
    sys.argv[1] if len(sys.argv) > 1 else _utils.get_base_branch(check_gh=True)
)
base_worktree = _utils.get_worktree(base_branch)
_utils.info(f"Updating {base_branch}...")
proc = subprocess.run(
    ["gitw-update", base_worktree],
    check=False,
    text=True,
    stdout=subprocess.PIPE,
    stderr=subprocess.STDOUT,
)
if proc.returncode != 0:
    print(proc.stdout.rstrip(), file=sys.stderr)
    sys.exit(1)

if _utils.repo_is_fork() and cur_branch == base_branch:
    base_branch = f"upstream/{base_branch}"

_utils.info(f"Rebasing {cur_branch} onto {base_branch}...")
proc = _utils.run_git_rebase(base_branch)
if proc.returncode != 0:
    sys.exit(1)
_utils.update_python_deps()
