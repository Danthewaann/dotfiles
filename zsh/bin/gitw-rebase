#!/usr/bin/env python3

import subprocess
import sys

import _utils

parser = _utils.create_parser()
parser.add_argument(
    "branch", nargs="?", default=None, help="branch to rebase current branch with"
)
args = parser.parse_args()

if not _utils.inside_worktree():
    _utils.error("Must be run inside a git worktree")
    sys.exit(1)

cur_branch = _utils.get_current_branch()
base_branch = args.branch if args.branch else _utils.get_base_branch(check_gh=True)
_utils.info(f"Updating {base_branch}...")
proc = subprocess.run(
    ["gitw-update", base_branch],
    check=False,
    text=True,
    stdout=subprocess.PIPE,
    stderr=subprocess.STDOUT,
)
if proc.returncode != 0:
    print(proc.stdout.rstrip(), file=sys.stderr)
    sys.exit(1)

if _utils.repo_is_fork() and cur_branch == base_branch:
    base_branch = f"upstream/{base_branch}"

_utils.info(f"Rebasing {cur_branch} onto {base_branch}...")
proc = _utils.run_git_rebase(base_branch)
if proc.returncode != 0:
    sys.exit(1)
_utils.update_python_deps()
