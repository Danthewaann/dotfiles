#!/usr/bin/env python3

import os
import pathlib
import re
import subprocess
import sys

import _utils

parser = _utils.create_parser()
parser.add_argument("worktree", help="worktree path to delete")
parser.add_argument("args", nargs="*", help="args to pass to 'git worktree remove'")

args = parser.parse_args()
worktree = pathlib.Path(args.worktree)
cmd_args: list[str] = args.args
force = "--force" in cmd_args or "-f" in cmd_args

if not worktree.is_dir():
    _utils.error(f"Worktree '{worktree.name}' doesn't exist!")
    sys.exit(1)
os.chdir(worktree)

worktree_name = pathlib.Path.cwd().parent.stem + "/" + worktree.stem
cur_branch = _utils.get_current_branch()

# Check if I have opened a PR for the current branch
prs = _utils.run_system_command(
    ["gh", "pr", "list", "--author", "@me"], log_output=False
).stdout
if not force and re.search(cur_branch, prs):
    _utils.warn("Skipping: ", end="")
    print(worktree_name, file=sys.stderr)
    print(_utils.indent("A PR is open for this worktree"))
    sys.exit(0)

# Make sure we don't delete worktrees that aren't pushed to their remote origin
local_branch_rev = _utils.run_system_command(
    ["git", "rev-parse", cur_branch], log_output=False
).stdout.strip()
proc = _utils.run_system_command(
    ["git", "rev-parse", f"origin/{cur_branch}"],
    exit_on_error=False,
    stderr=subprocess.DEVNULL,
)
remote_branch_rev = local_branch_rev
if proc.returncode == 0:
    remote_branch_rev = proc.stdout.strip()

if local_branch_rev != remote_branch_rev:
    _utils.warn("Skipping: ", end="")
    print(worktree_name, file=sys.stderr)
    print(_utils.indent("Local branch is not synced with remote origin branch"))
    sys.exit(0)

proc = _utils.run_system_command(
    ["git", "worktree", "remove", worktree, *cmd_args], exit_on_error=False
)
if proc.returncode != 0:
    _utils.error("Failed to delete: ", end="")
    print(worktree_name, file=sys.stderr)
    sys.exit(1)

_utils.success("Successfully deleted: ", end="")
print(worktree_name, file=sys.stderr)
