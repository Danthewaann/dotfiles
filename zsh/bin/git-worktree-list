#!/usr/bin/env python3

import os
import pathlib
import re

import _utils

parser = _utils.create_parser()
parser.parse_args()

# If we are already inside a worktree change directory to the bare repo
if _utils.inside_worktree():
    cur_worktree = _utils.get_worktree()
    os.chdir(cur_worktree.parent)

if not _utils.inside_bare_repo():
    for dirpath, dirnames, filenames in pathlib.Path.cwd().walk():
        for dir in dirnames:
            if (dirpath / dir / ".bare").exists():
                _utils.run_system_command(
                    "git-worktree-list",
                    capture_output=False,
                    exit_on_error=False,
                    cwd=dirpath / dir,
                )
else:
    cur_dir = pathlib.Path.cwd()
    worktrees = _utils.run_system_command(
        ["git", "worktree", "list"], log_output=False
    ).stdout
    for worktree in worktrees.splitlines():
        if not re.search(r"(\[main\]|\[master\]|\(bare\))", worktree):
            print(worktree.split()[0])
