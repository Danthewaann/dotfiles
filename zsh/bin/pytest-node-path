#!/usr/bin/env python3
import argparse
import ast
import sys

import _utils

parser = argparse.ArgumentParser(prog="pytest-node-path")
parser.add_argument("node")

args = parser.parse_args()
node: str = args.node

if "::" not in node:
    _utils.error(f"Node '{node}' isn't a pytest test node!")
    sys.exit(1)

path, _, nodeid = node.partition("::")
nodeid = nodeid.split("[")[0]  # collapse parametrised cases

try:
    with open(path, "r") as rfp:
        tree = ast.parse(rfp.read())
except (OSError, SyntaxError) as e:
    _utils.error(f"Failed to read {path}: {e}")
    sys.exit(1)

out: dict[str, int] = {}
for tree_node in tree.body:
    if isinstance(tree_node, (ast.FunctionDef, ast.AsyncFunctionDef)):
        out[tree_node.name] = tree_node.lineno
    elif isinstance(tree_node, ast.ClassDef):
        out[tree_node.name] = tree_node.lineno
        for m in tree_node.body:
            if isinstance(m, (ast.FunctionDef, ast.AsyncFunctionDef)):
                out[f"{tree_node.name}::{m.name}"] = m.lineno

print(f"{path}:{out.get(nodeid, 1)}: {nodeid}")
