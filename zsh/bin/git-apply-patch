#!/usr/bin/env python3

import platform
import subprocess
import sys

import _utils

parser = _utils.create_parser()
parser.parse_args()

if platform.system() == "Darwin":
    command = ["pbpaste"]
else:
    command = ["xclip", "-selection", "clipboard", "-o"]

patch = _utils.check_output(command)

proc = subprocess.run(["git", "apply", "-"], check=False, text=True, input=patch)
if proc.returncode != 0:
    sys.exit(1)
