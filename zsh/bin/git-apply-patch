#!/usr/bin/env python3

import platform

import _utils

parser = _utils.create_parser()
parser.parse_args()

if platform.system() == "Darwin":
    command = ["pbpaste"]
else:
    command = ["xclip", "-selection", "clipboard", "-o"]

patch = _utils.run_system_command(command, log_output=False).stdout
_utils.run_system_command(["git", "apply", "-"], capture_output=False, input=patch)
