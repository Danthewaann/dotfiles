#!/usr/bin/env python3

import os
import pathlib

import _utils

SESSIONS_TO_KEEP = 10

parser = _utils.create_parser()
parser.add_argument(
    "--keep-recent",
    dest="keep_recent",
    action="store_true",
    default=False,
    help=f"don't kill the last {SESSIONS_TO_KEEP} active non-saved sessions",
)

args = parser.parse_args()
keep_recent: bool = args.keep_recent

base_dir = str(pathlib.Path(os.environ["TMUX_CURRENT_DIR"]).stem)
current_session = _utils.run_system_command(
    ["tmux", "display-message", "-p", "#S"], log_output=False
).stdout.strip()
all_sessions = list(
    map(
        str.strip,
        _utils.run_system_command(
            ["tmux", "list-sessions", "-F", "#S"], log_output=False
        ).stdout.splitlines(),
    )
)
active_sessions: list[str] = sorted(
    _utils.run_system_command(
        ["tmux", "list-sessions", "-F", "#{session_last_attached} #S"], log_output=False
    ).stdout.splitlines(),
    reverse=True,
)

default_sessions_file = pathlib.Path.home() / ".tmux-default-sessions"
default_sessions: list[str] = []
if default_sessions_file.exists():
    default_sessions = default_sessions_file.read_text().splitlines()

saved_sessions_file = pathlib.Path.home() / ".tmux-save-sessions"
saved_sessions: list[str] = []
if saved_sessions_file.exists():
    saved_sessions = saved_sessions_file.read_text().splitlines()

if not keep_recent:
    for session in all_sessions:
        if (
            session != current_session
            and session not in default_sessions
            and session not in saved_sessions
        ):
            _utils.run_system_command(
                ["tmux", "kill-session", "-t", session], capture_output=False
            )
else:
    recent_active_sessions: list[str] = []
    count = 0
    for session in active_sessions:
        if count == SESSIONS_TO_KEEP:
            break

        _, session = session.split()
        if (
            session not in default_sessions
            and session not in saved_sessions
            and session != base_dir
        ):
            recent_active_sessions.append(session)
            count += 1

    for session in all_sessions:
        if (
            session not in default_sessions
            and session not in saved_sessions
            and session not in recent_active_sessions
        ):
            _utils.run_system_command(
                ["tmux", "kill-session", "-t", session], capture_output=False
            )
