#!/usr/bin/env bash

cur_session="${1}"
worktree_max_len="${2:-15}"
repo_len="${3:-20}"
max_width="${4:-$(tmux display-message -p '#{client_width}' 2>/dev/null || tput cols)}"
onedark_black2="#272731"
onedark_white="#abb2bf"
onedark_green="#98c379"

abbreviations_file="$HOME/.tmux-abbreviations"
declare -A abbreviations=()
if [[ -f "$abbreviations_file" ]]; then
	while IFS='=' read -r key value; do
		[[ -z "$key" || "$key" == \#* ]] && continue
		abbreviations["$key"]="$value"
	done <"$abbreviations_file"
fi

abbreviate() {
	local str="$1" key
	for key in "${!abbreviations[@]}"; do
		str="$(sed -E "s/${key}/${abbreviations[$key]}/g" <<<"$str")"
	done
	echo "$str"
}

sessions=()
total_len=0
session_number=0
while IFS=$'\n' read -r line; do
	session_number=$((session_number + 1))
	if [[ "$cur_session" == "$line" ]]; then continue; fi
	num_slashes="${line//[^\/]/}"
	if [[ ${#num_slashes} -gt 1 ]]; then
		line="$(cut -d'/' -f2- <<<"$line")"
	fi

	repo="$(abbreviate "$(cut -d'/' -f1 <<<"$line")")"
	worktree="$(cut -d'/' -f2 <<<"$line")"
	trimmed_worktree="$(sed -E 's/^[^-]+-sc-[0-9]+-?//' <<<"$worktree")"
	short_repo="${repo:0:repo_len}"
	short_worktree="$trimmed_worktree"
	if ((${#trimmed_worktree} > worktree_max_len)); then
		short_worktree="${trimmed_worktree:0:worktree_max_len}…"
	fi
	display="$short_repo/$short_worktree"
	plain="${session_number}:${display}"
	sep=0
	((${#sessions[@]} > 0)) && sep=1
	if ((total_len + sep + ${#plain} > max_width)); then
		break
	fi
	total_len=$((total_len + sep + ${#plain}))
	sessions+=("#[fg=$onedark_green,bg=$onedark_black2]${session_number}#[fg=$onedark_white,bg=$onedark_black2]:$display")
done <"$HOME/.tmux-save-sessions"

printf "%s " "${sessions[@]}"
((${#sessions[@]} > 0)) && printf "| "

num_slashes="${cur_session//[^\/]/}"
if [[ ${#num_slashes} -gt 1 ]]; then
	repo="$(abbreviate "$(cut -d'/' -f2 <<<"$cur_session")")"
	worktree="$(cut -d'/' -f3 <<<"$cur_session")"
	trimmed_worktree="$(sed -E 's/^[^-]+-sc-[0-9]+-?//' <<<"$worktree")"
	printf "%s/%s " "$repo" "$trimmed_worktree"
else
	printf "%s " "$cur_session"
fi
