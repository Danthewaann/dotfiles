#!/usr/bin/env python3

import argparse
import pathlib

import _utils

parser = argparse.ArgumentParser()
parser.add_argument("current_session", nargs="?")

args = parser.parse_args()
current_session: str = args.current_session

current_session = (
    current_session
    or _utils.check_output(["tmux", "display-message", "-p", "#S"]).strip()
)

saved_sessions_file = pathlib.Path.home() / ".tmux-save-sessions"
saved_sessions: list[str] = []
if saved_sessions_file.exists():
    for line in saved_sessions_file.read_text().splitlines():
        saved_sessions.append(line.strip())

if current_session not in saved_sessions:
    with saved_sessions_file.open("a") as wfp:
        wfp.write(current_session)
        wfp.write("\n")
    _utils.check_output(
        ["tmux", "display-message", f"Added {current_session} to saved sessions!"]
    )
else:
    _utils.check_output(
        [
            "tmux",
            "display-message",
            f"{current_session} already added to saved sessions!",
        ]
    )
