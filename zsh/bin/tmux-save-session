#!/usr/bin/env python3

import pathlib

import _utils

parser = _utils.create_parser()
parser.add_argument("session", nargs="?", default=None, help="session to save")

args = parser.parse_args()
session: str | None = args.session
session = (
    session
    or _utils.run_system_command(
        ["tmux", "display-message", "-p", "#S"], log_output=False
    ).stdout.strip()
)

saved_sessions_file = pathlib.Path.home() / ".tmux-save-sessions"
saved_sessions: list[str] = []
if saved_sessions_file.exists():
    for line in saved_sessions_file.read_text().splitlines():
        saved_sessions.append(line.strip())

if session not in saved_sessions:
    with saved_sessions_file.open("a") as wfp:
        wfp.write(session)
        wfp.write("\n")
    _utils.run_system_command(
        ["tmux", "display-message", f"Added {session} to saved sessions!"],
        log_output=False,
    )
else:
    _utils.run_system_command(
        [
            "tmux",
            "display-message",
            f"{session} already added to saved sessions!",
        ],
        log_output=False,
    )
