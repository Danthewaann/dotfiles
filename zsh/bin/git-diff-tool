#!/usr/bin/env python3


import _utils

parser = _utils.create_parser()
parser.add_argument(
    "base_branch",
    nargs="?",
    default=None,
    help="base branch to diff current branch against",
)
parser.add_argument(
    "cur_branch", nargs="?", default=None, help="current branch to diff with"
)
args = parser.parse_args()
base_branch: str = args.base_branch or _utils.get_base_branch(check_gh=True)
cur_branch: str = args.cur_branch or _utils.get_current_branch()

_utils.run_system_command(
    ["git", "difftool", "-d", base_branch, cur_branch],
    capture_output=False,
)
