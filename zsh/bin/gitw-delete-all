#!/usr/bin/env python3

import pathlib
import re
import sys

import _utils

parser = _utils.create_parser()
parser.add_argument("args", nargs="*", help="args to pass to 'gitw-delete'")
args: list[str] = parser.parse_args().args

if not _utils.inside_bare_repo():
    for dirpath, dirnames, filenames in pathlib.Path.cwd().walk():
        for dir in dirnames:
            if (dirpath / dir / ".bare").exists():
                _utils.run_system_command(
                    ["gitw-delete-all", "--colour=yes", *args],
                    capture_output=False,
                    cwd=dirpath / dir,
                )
else:
    cur_dir = pathlib.Path.cwd().stem
    _utils.info(f"Checking for git worktrees in {cur_dir}...")
    worktrees = _utils.run_system_command(
        ["git", "worktree", "list"], log_output=False
    ).stdout
    for worktree in worktrees.splitlines():
        if not re.search(r"(\[main\]|\[master\]|\(bare\))", worktree):
            proc = _utils.run_system_command(
                ["gitw-delete", "--colour=yes", worktree.split()[0], *args],
                log_output=False,
                exit_on_error=False,
            )
            print(_utils.indent(proc.stdout.strip()), file=sys.stderr)
