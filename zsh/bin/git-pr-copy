#!/usr/bin/env python3

import sys

import _utils

parser = _utils.create_parser()
parser.parse_args()

pr_url = _utils.run_system_command(
    ["gh", "pr", "view", "--json", "url", "--jq", ".url"], log_output=False
).stdout.strip()

_utils.copy_to_clipboard(pr_url)
print("\nThe below has been copied to your clipboard! 📋\n", file=sys.stderr)
print(pr_url)
