#!/usr/bin/env python3

import subprocess

import _utils

parser = _utils.create_parser()
parser.add_argument(
    "pr_number", nargs="?", type=int, default=None, help="PR number to review"
)
args = parser.parse_args()

pr_number = (
    args.pr_number
    if args.pr_number is not None
    else _utils.check_output(
        ["gh", "pr", "view", "--json", "number", "--jq", ".number"]
    ).strip()
)

subprocess.run(f"nvim . -c 'Octo pr edit {pr_number}'", shell=True, check=True)
