#!/usr/bin/env python3


import _utils

parser = _utils.create_parser()
parser.add_argument(
    "pr_number", nargs="?", type=int, default=None, help="PR number to review"
)
args = parser.parse_args()

pr_number = (
    args.pr_number
    if args.pr_number is not None
    else _utils.run_system_command(
        ["gh", "pr", "view", "--json", "number", "--jq", ".number"], log_output=False
    ).stdout.strip()
)

_utils.run_system_command(
    ["nvim", ".", "-c", f"Octo pr edit {pr_number}"], capture_output=False
)
