#!/usr/bin/env python3

import argparse
import os
import pathlib
import shutil
import sys
import time
from collections.abc import Sequence
from typing import Any, Literal

import _utils


def validate_working_dir(value: Any) -> pathlib.Path | None:
    if not value:
        return None

    working_dir = pathlib.Path(value)
    if not working_dir.exists():
        # If this directory doesn't exist, check if it exists under my directory
        # This is useful for switching to my forks of github repos
        working_dir = pathlib.Path("Workspace/Danthewaann").resolve() / working_dir.name

        if not working_dir.is_dir():
            raise argparse.ArgumentTypeError(
                f"must provide a valid directory, got {working_dir}"
            )

    return working_dir


parser = _utils.create_parser()
parser.add_argument("branch", help="branch to create a worktree for")
parser.add_argument("args", nargs="*", help="args to pass to 'tmux-sessionizer'")
parser.add_argument(
    "-C",
    dest="working_dir",
    type=validate_working_dir,
    help="directory to run this script within",
)
parser.add_argument(
    "-n",
    dest="new_win",
    choices=("win", "split", "vsplit"),
    default=None,
    help="window arg to pass to 'tmux-sessionizer'",
)
parser.add_argument(
    "--only-checkout",
    action="store_true",
    default=False,
    help="only checkout the branch into a worktree",
)

parsed_args = parser.parse_args()
branch_name: str = parsed_args.branch
args: Sequence[str] = parsed_args.args
working_dir: pathlib.Path | None = parsed_args.working_dir
new_win: Literal["win", "split", "vsplit"] | None = parsed_args.new_win
only_checkout: bool = parsed_args.only_checkout

# For use in tmux-sessionizer
win_args: list[str] = []
if new_win is not None:
    win_args = [new_win]

if working_dir:
    os.chdir(working_dir)

# If the branch name starts with `origin/` remove that section
if branch_name.startswith("origin/"):
    branch_name = branch_name.split("/", 1)[1]

# Convert all forward slashes to dashes and dots to underscores as tmux sessions can't contain dots
converted_name = branch_name.replace("/", "-").replace(".", "_")

# If we are already inside a worktree change directory to the bare repo
if _utils.inside_worktree():
    cur_worktree = _utils.get_worktree()
    os.chdir(pathlib.Path(cur_worktree).parent)

# Make sure we are inside a bare repo before proceeding
if not _utils.inside_bare_repo():
    _utils.error("Must be run in a worktree or bare repository!")
    sys.exit(1)

# If the worktree already exists and `--only-checkout` is set then just exit
worktree_exists = pathlib.Path(converted_name).is_dir()
if only_checkout and worktree_exists:
    sys.exit(0)

# If the worktree already exists and `--only-checkout` isn't set, switch to it
if not only_checkout and worktree_exists:
    _utils.info("Switching to worktree...")
    sys.exit(
        _utils.run_system_command(
            ["tmux-sessionizer", pathlib.Path.cwd() / converted_name, *win_args, *args],
            capture_output=False,
            exit_on_error=False,
        ).returncode
    )

# If we get to this point, the branch hasn't been checked out into a worktree yet
# When running `git fetch` remote branch info will be fetched, meaning theses branches
# will appear as if they have been created locally when we run `git branch` below.
_utils.run_git_fetch()

# Create or reset the branch at this point. Any commits in this branch that
# don't match what's in the remote will be removed. I don't think this will
# cause any problems for my workflow, as I always associate a branch with a
# physical checkout.
local_branch_arg = ["-B", branch_name]

# If this branch exists remotely, set up tracking info for the local branch
remote_tracking_arg = []
remote_branches = _utils.run_system_command(
    ["git", "ls-remote", "--branches", "origin"]
).stdout
if branch_name in remote_branches:
    remote_tracking_arg = ["--track", f"origin/{branch_name}"]

# Create a new worktree using the converted name whilst checking out the branch
add_args = [
    "git",
    "worktree",
    "add",
    converted_name,
    *local_branch_arg,
    *remote_tracking_arg,
]
_utils.info("Creating worktree...")
_utils.run_system_command(add_args)

# Copy .projections.json if found
cur_worktree = _utils.get_worktree(branch=_utils.get_base_branch())
projections_file = cur_worktree / ".projections.json"
if projections_file.exists():
    try:
        shutil.copy(projections_file, f"{converted_name}/.projections.json")
    except shutil.SameFileError:
        pass

# We have now created the worktree, so exit here if `--only-checkout` is set
if only_checkout:
    sys.exit(0)

# Enter the new worktree
os.chdir(converted_name)

# Post checkout steps
if args:
    args = ["update-deps", "&&", *args]
else:
    args = ["update-deps"]

_utils.success("Successfully created worktree!")
_utils.info("Switching to worktree...")
time.sleep(0.3)
sys.exit(
    _utils.run_system_command(
        ["tmux-sessionizer", pathlib.Path.cwd(), *win_args, *args],
        capture_output=False,
        exit_on_error=False,
    ).returncode
)
